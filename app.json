{
  "expo": {
    "name": "SPSM",
    "slug": "SPSM",
    "scheme": [
      "spsm"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "id.my.basthdev.spsm",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "id.my.basthdev.spsm",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./src/assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./src/assets/images/logo.png",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/logo.png",
          "color": "#0A4C8F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1ee77b6c-db4b-4b5d-995c-2d448f255f44"
      }
    },
    "owner": "basth"
  }
}