# ---- Server ----
PORT=5000
NODE_ENV=production
# WAJIB diganti — generate: openssl rand -hex 32
JWT_SECRET=ganti-dengan-random-hex-32

# ---- Appwrite Self-Hosted ----
# Endpoint publik (lewat Traefik/Appwrite domain). Alternatif internal:
# http://appwrite:80/v1  — tapi public endpoint lebih aman (Host header benar).
APPWRITE_ENDPOINT=https://app-spsm.unmuha.ac.id/v1
APPWRITE_PROJECT_ID=<project-id-dari-console>
APPWRITE_API_KEY=<api-key-server-dari-console>
APPWRITE_DATABASE_ID=spsm_db

# ---- FCM Push Notifications ----
# Service account JSON dari Firebase console. Pilih salah satu:
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- Gemini (opsional, validasi judul) ----
# GEMINI_API_KEY=

# ---- Traefik / Compose ----
# Domain untuk API backend (A record -> IP server)
API_DOMAIN=api-spsm.unmuha.ac.id
# Nama docker network milik Appwrite — cek dengan: docker network ls | grep appwrite
APPWRITE_NETWORK=appwrite_appwrite
