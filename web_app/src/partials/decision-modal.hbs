{{! Modal Catatan Revisi / Penolakan per Opsi Judul — dipakai reviewer & kaprodi
     JS mengisi #decision-options-container dan menangani submit via window.submitDecision() }}
<div id="decision-modal" class="fixed inset-0 z-[60] hidden bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
  <div class="card w-full max-w-2xl max-h-[90vh] flex flex-col bg-default shadow-2xl border border-default rounded-2xl overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 bg-primary text-white border-b border-default">
      <div>
        <h3 class="text-sm font-bold text-white" id="decision-modal-title">Catatan Evaluasi per Judul</h3>
        <p class="text-[11px] text-blue-200" id="decision-modal-subhead"></p>
      </div>
      <button type="button" class="btn btn-icon size-8 text-white/80 hover:text-white bg-white/10 rounded-lg cursor-pointer" onclick="closeDecisionModal()">✕</button>
    </div>

    <div class="p-6 overflow-y-auto space-y-4">
      <div id="decision-options-container" class="space-y-3">
        {{! diisi dinamis per opsi judul }}
      </div>

      <div>
        <label class="block text-xs font-bold text-default mb-1.5">Catatan Tambahan (Opsional)</label>
        <textarea id="decision-general-notes" rows="2" class="form-control text-xs w-full p-2.5 border-default rounded-lg" placeholder="Catatan umum untuk mahasiswa..."></textarea>
      </div>
    </div>

    <div class="px-6 py-4 bg-subtle border-t border-default flex items-center justify-end gap-2">
      <button type="button" class="btn btn-outline-neutral text-xs py-2 px-3" onclick="closeDecisionModal()">Batal</button>
      <button type="button" id="btn-confirm-decision" class="btn btn-primary text-xs font-bold py-2 px-4">Kirim Keputusan</button>
    </div>
  </div>
</div>
