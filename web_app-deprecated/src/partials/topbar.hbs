<header class="sticky top-0 z-10 flex h-(--topbar-height) items-center gap-4 border-b border-default bg-default px-4 sm:px-6 lg:px-8">
  <button
    type="button"
    class="btn btn-icon size-auto p-0 text-muted lg:hidden"
    data-bs-toggle="offcanvas"
    data-bs-target="#sidebar"
    aria-controls="sidebar"
    aria-label="Open navigation"
  >
    {{> icons/menu}}
  </button>
  <h1 class="sr-only">{{title}}</h1>

  <div class="hidden items-center gap-2 md:flex">
    <span class="badge badge-primary px-2.5 py-1 text-xs font-bold uppercase tracking-wider">Portal Akademik</span>
    <span class="text-xs text-muted font-medium">Sistem Pengajuan Skripsi Mahasiswa</span>
  </div>

  <div class="ms-auto flex items-center gap-4 lg:-me-2">
    <div class="dropdown ms-2.5">
      <button type="button" class="flex items-center gap-2.5 text-start cursor-pointer p-1 rounded-lg hover:bg-muted" data-bs-toggle="dropdown" aria-expanded="false">
        <img id="topbar-user-avatar" src="{{@root.root}}{{@root.site.user.avatar}}" alt="Avatar" class="size-8 rounded-full object-cover border border-default" />
        <span class="hidden leading-tight sm:block">
          <span id="topbar-user-name" class="block text-sm font-bold text-default">{{@root.site.user.name}}</span>
          <span id="topbar-user-role" class="block text-xs font-semibold text-primary">{{@root.site.user.role}}</span>
        </span>
      </button>
      <div class="dropdown-menu dropdown-menu-end w-48 shadow-lg">
        <div class="px-4 py-2 text-xs border-b border-default">
          <div class="font-bold text-default" id="dropdown-user-name">Pengguna</div>
          <div class="text-muted truncate" id="dropdown-user-email">email@kampus.ac.id</div>
        </div>
        <button id="btn-topbar-logout" type="button" class="dropdown-item text-red-600 font-semibold flex items-center gap-2 cursor-pointer w-full text-start py-2">
          Keluar dari Akun
        </button>
      </div>
    </div>
  </div>
</header>
